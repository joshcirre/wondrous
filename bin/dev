#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
WONDROUS_PHP="${WONDROUS_PHP:-php}"
if ! "$WONDROUS_PHP" -v >/dev/null 2>&1; then
  if [ -x /opt/homebrew/opt/php@8.4/bin/php ]; then WONDROUS_PHP=/opt/homebrew/opt/php@8.4/bin/php; else echo 'PHP 8.4.1+ is required. Set WONDROUS_PHP to its executable.' >&2; exit 1; fi
fi
npx concurrently --kill-others -n web,queue,reverb,scheduler,vite -c green,blue,magenta,cyan,yellow \
  "$WONDROUS_PHP artisan serve --host=127.0.0.1 --port=${WONDROUS_PORT:-8005}" \
  "$WONDROUS_PHP artisan queue:work --tries=3 --timeout=60" \
  "$WONDROUS_PHP artisan reverb:start --host=127.0.0.1 --port=8080" \
  "$WONDROUS_PHP artisan schedule:work" \
  'npm run dev'
